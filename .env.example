# Copia questo file in .env (già escluso da git) solo per prove in locale.
# In produzione le variabili stanno su Vercel e nei GitHub Secrets.

# Token del bot dato da @BotFather
TELEGRAM_BOT_TOKEN=

# Username del bot senza @ (opzionale, serve nei gruppi per ignorare comandi rivolti ad altri bot)
TELEGRAM_BOT_USERNAME=

# Id della tua chat privata con il bot (lo ottieni scrivendo /id al bot)
TELEGRAM_CHAT_ID=

# Id del gruppo di coppia (opzionale, numero negativo)
TELEGRAM_CHAT_ID_COPPIA=

# Stringa casuale che Telegram rimanda a ogni chiamata del webhook
TELEGRAM_WEBHOOK_SECRET=

# Stringa casuale che cron-job.org manda nell'header Authorization
CRON_SECRET=

# Come ti saluta il bot la mattina
AZDORA_NOME=Ale
